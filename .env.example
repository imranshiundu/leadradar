# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
DATABASE_PATH=./lead_radar.db
SOURCES_PATH=./config/sources.example.json
USER_AGENT=LeadRadarSafe/1.0 (+contact@example.com)

# Groq classification. Keep model small/cheap; override with any currently available Groq model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_ENABLED=true

# Search provider. Brave Search API is recommended because it is API-based rather than page scraping.
BRAVE_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=10

# Telegram alerts and controlled channel ingestion.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=true

# Gmail SMTP with App Password. Prefer a dedicated outreach account/domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Imran
SMTP_FROM_EMAIL=
SMTP_DAILY_LIMIT=25
SMTP_MIN_SECONDS_BETWEEN_SENDS=300

# Reply tracking via IMAPS (Gmail).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
INBOX_POLL_ENABLED=true
INBOX_POLL_MINUTES=10

# Dashboard auth — set a token to protect mutating routes (approve/send/import).
# Leave blank to disable auth (local dev only).
DASHBOARD_TOKEN=

# Safety
AUTO_SEND_EMAILS=false
REQUIRE_MANUAL_APPROVAL=true
RESPECT_ROBOTS_TXT=true
CRAWL_DELAY_SECONDS=2
MAX_LEADS_PER_RUN=80
MIN_NEED_SCORE_FOR_ALERT=65
MIN_OPPORTUNITY_SCORE_FOR_ALERT=70
